MackeyDiagrams.PlanarCode.Equivalent.exchange (before after : MackeyDiagrams.PlanarCode.Code) (i gap : ℕ)
  (left right : MackeyDiagrams.PlanarEvent) :
  MackeyDiagrams.PlanarCode.Equivalent
    (before ++
        [MackeyDiagrams.PlanarEvent.place i left,
          MackeyDiagrams.PlanarEvent.place (i + left.outputs.length + gap) right] ++
      after)
    (before ++
        [MackeyDiagrams.PlanarEvent.place (i + left.inputs.length + gap) right,
          MackeyDiagrams.PlanarEvent.place i left] ++
      after)
MackeyDiagrams.PlanarCode.Equivalent.context (before after : MackeyDiagrams.PlanarCode.Code)
  {a b : MackeyDiagrams.PlanarCode.Code} :
  MackeyDiagrams.PlanarCode.Equivalent a b →
    MackeyDiagrams.PlanarCode.Equivalent (before ++ a ++ after) (before ++ b ++ after)
