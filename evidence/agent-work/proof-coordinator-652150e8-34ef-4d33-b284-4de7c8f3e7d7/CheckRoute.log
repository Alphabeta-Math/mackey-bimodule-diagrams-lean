MackeyDiagrams.Word.eval_reorderToFrom.{u, v} {U : Type u} [Group U] {K H : Subgroup U} {R : Type v} [CommSemiring R]
  (p : MackeyDiagrams.Word K H) :
  (p.reorderToBoundary.vertical p.reorderFromBoundary).eval = (MackeyDiagrams.Diagram.id p).eval
MackeyDiagrams.Word.eval_reorderFromTo.{u, v} {U : Type u} [Group U] {K H : Subgroup U} {R : Type v} [CommSemiring R]
  (p : MackeyDiagrams.Word K H) :
  (p.reorderFromBoundary.vertical p.reorderToBoundary).eval = (MackeyDiagrams.Diagram.id p.boundary.word).eval
MackeyDiagrams.Biset.Hom.transferBasis_sum.{u, v} {K H : Type u} [Group K] [Group H] {X Y : MackeyDiagrams.Biset K H}
  (R : Type v) [CommSemiring R] (f : X.carrier → Y.carrier) (finite : ∀ (y : Y.carrier), {x | f x = y}.Finite)
  (y : Y.carrier) : MackeyDiagrams.Biset.Hom.transferBasis R f finite y = ∑ x ∈ ⋯.toFinset, Finsupp.single x 1
MackeyDiagrams.Biset.associateBasisEquiv.{u} {K H J F : Type u} [Group K] [Group H] [Group J] [Group F]
  (X : MackeyDiagrams.Biset K H) (Y : MackeyDiagrams.Biset H J) (Z : MackeyDiagrams.Biset J F) :
  ((X.tensor Y).tensor Z).carrier ≃ (X.tensor (Y.tensor Z)).carrier
MackeyDiagrams.Generator.mixedEquiv.{u} {U : Type u} [Group U] {H K G : Subgroup U}
  (a : MackeyDiagrams.ConjEmbedding K G) (b : MackeyDiagrams.ConjEmbedding H G) :
  ((MackeyDiagrams.Biset.restriction a).tensor (MackeyDiagrams.Biset.induction b)).carrier ≃ ↥G
MackeyDiagrams.ScopedDiagram.eval_linearCombination_apply.{u, v} {U : Type u} [Group U] {R : Type v} [CommSemiring R]
  {K H : Subgroup U} {p q : MackeyDiagrams.Word K H} (terms : List (R × MackeyDiagrams.ScopedDiagram R p q))
  (x : p.basis.carrier →₀ R) :
  (MackeyDiagrams.ScopedDiagram.linearCombination terms).eval.toLinearMap x =
    (List.map (fun term => term.1 • term.2.eval.toLinearMap x) terms).sum
MackeyDiagrams.PointwiseIndexedDrawing.evalAt_def.{u, v, w} {U : Type u} [Group U] {K H : Subgroup U} {R : Type v}
  [CommSemiring R] {p q : MackeyDiagrams.Word K H} {ι : Type w} (d : MackeyDiagrams.PointwiseIndexedDrawing R p q ι)
  (x : p.basis.carrier →₀ R) : d.evalAt x = ∑ i ∈ ⋯.toFinset, (d.summand i).interpret.eval.toLinearMap x
MackeyDiagrams.PointwiseIndexedDrawing.eval_apply.{u, v, w} {U : Type u} [Group U] {K H : Subgroup U} {R : Type v}
  [CommSemiring R] {p q : MackeyDiagrams.Word K H} {ι : Type w} (d : MackeyDiagrams.PointwiseIndexedDrawing R p q ι)
  (x : p.basis.carrier →₀ R) : d.eval x = d.evalAt x
