import NotesProofs.General.OriginalBimoduleAdapter

/-! The balanced-tensor and naturality formulas for the paper workflow's
bimodule encoding and the checked Eilenberg–Watts equivalence. -/

set_option backward.isDefEq.respectTransparency false

namespace NotesProofs.General

universe u v
open CategoryTheory

variable (R S : Type u) [Ring R] [Ring S]

/-- The tensor functor selected by the paper-style equivalence. -/
noncomputable abbrev originalTensor (B : OriginalBimodule.{u,v} R S) :
    ModuleCat.{max u v} R ⥤ ModuleCat.{max u v} S :=
  ((originalWattsWithEvaluation.{u,v} R S).functor.obj B).obj

/-- Its elementary tensor. -/
noncomputable def originalTensorPure (B : OriginalBimodule.{u,v} R S) (X : ModuleCat.{max u v} R) :
    B.1 → X → (originalTensor R S B).obj X :=
  fun b x => concretePure (R := R) (M := (originalToConcreteObj R S B).carrier) (X := X) b x

/-- The paper's balanced and outer-linear generator conditions. -/
def originalBalanced (B : OriginalBimodule.{u,v} R S)
    (X : ModuleCat.{max u v} R) (Y : ModuleCat.{max u v} S) (p : B.1 → X → Y) : Prop :=
  (∀ b b' x, p (b + b') x = p b x + p b' x) ∧
  (∀ b x x', p b (x + x') = p b x + p b x') ∧
  (∀ (s : S) b x, p (s • b) x = s • p b x) ∧
  (∀ (r : R) b x, p (originalRight R S B b r) x = p b (r • x))

/-- The selected tensor is generated by a balanced map with the universal
property for S-linear maps. -/
theorem originalTensorPure_universal (B : OriginalBimodule.{u,v} R S)
    (X : ModuleCat.{max u v} R) :
    originalBalanced R S B X ((originalTensor R S B).obj X) (originalTensorPure R S B X) ∧
    ∀ (Y : ModuleCat.{max u v} S) (p : B.1 → X → Y), originalBalanced R S B X Y p →
      ∃! f : (originalTensor R S B).obj X →ₗ[S] Y, ∀ b x, f (originalTensorPure R S B X b x) = p b x := by
  let M := originalToConcreteObj R S B
  letI : AddCommGroup (ChoiceFreeWatts.Tensor (rightAction (R := R) (M := M.carrier)) X) :=
    ChoiceFreeWatts.tensorAddCommGroup _
  letI : Module S (ChoiceFreeWatts.Tensor (rightAction (R := R) (M := M.carrier)) X) :=
    ChoiceFreeWatts.outerModule _ right_commute
  have hp := concretePure_isBalancedTensor (R := R) (S := S) (M := M.carrier) (X := X)
  constructor
  · refine ⟨?_, ?_, ?_, ?_⟩
    · intro b b' x
      exact DFunLike.congr_fun (map_add (concretePure (R := R) (M := M.carrier) (X := X)) b b') x
    · intro b x x'
      exact map_add (concretePure (R := R) (M := M.carrier) (X := X) b) x x'
    · intro s b x
      exact hp.2.1 s b x
    · intro r b x
      exact hp.1 r b x
  · intro Y p hp'
    let bp : M.carrier →+ (X →+ Y) := AddMonoidHom.mk'
      (fun b => AddMonoidHom.mk' (p b) (hp'.2.1 b)) (by
        intro b b'
        ext x
        exact hp'.1 b b' x)
    exact hp.2.2 Y bp hp'.2.2.2 hp'.2.2.1

/-- Tensoring is natural on the module input. -/
theorem originalTensorPure_map (B : OriginalBimodule.{u,v} R S)
    {X Y : ModuleCat.{max u v} R} (f : X ⟶ Y) (b : B.1) (x : X) :
    ((originalTensor R S B).map f).hom (originalTensorPure R S B X b x) =
      originalTensorPure R S B Y b (f.hom x) := by
  exact concreteTensorMap_pure (M := (originalToConcreteObj R S B).carrier) (S := S) f.hom b x

/-- Bimodule maps act on elementary tensors in the expected way. -/
theorem originalTensorPure_bimoduleMap (B C : OriginalBimodule.{u,v} R S) (f : B ⟶ C)
    (X : ModuleCat.{max u v} R) (b : B.1) (x : X) :
    (((originalWattsWithEvaluation.{u,v} R S).functor.map f).hom.app X).hom
      (originalTensorPure R S B X b x) = originalTensorPure R S C X (f.1 b) x := by
  exact tensorBimoduleMapComponent_pure ((originalToConcrete R S).map f) X b x

#print axioms originalTensorPure_universal
#print axioms originalTensorPure_map
#print axioms originalTensorPure_bimoduleMap

end NotesProofs.General
