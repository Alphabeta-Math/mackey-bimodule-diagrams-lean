CategoryTheory.Functor.FullyFaithful.homEquiv_symm_apply.{v₁, v₂, u₁, u₂} {C : Type u₁} [Category.{v₁, u₁} C]
  {D : Type u₂} [Category.{v₂, u₂} D] {F : C ⥤ D} (hF : F.FullyFaithful) {X Y : C} (f : F.obj X ⟶ F.obj Y) :
  hF.homEquiv.symm f = hF.preimage f
