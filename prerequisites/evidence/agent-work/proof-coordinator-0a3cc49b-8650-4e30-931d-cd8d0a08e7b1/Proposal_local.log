NotesProofs.balanced_tensor_preserves_cokernel.{u, v} {R S : Type u} [Ring R] [Ring S] {M L N Q TL TN TQ : Type v}
  [AddCommGroup M] [Module Rᵐᵒᵖ M] [Module S M] [AddCommGroup L] [Module R L] [AddCommGroup N] [Module R N]
  [AddCommGroup Q] [Module R Q] [AddCommGroup TL] [Module S TL] [AddCommGroup TN] [Module S TN] [AddCommGroup TQ]
  [Module S TQ] (f : L →ₗ[R] N) (q : N →ₗ[R] Q) (q_surj : Function.Surjective ⇑q)
  (exact : ∀ (n : N), q n = 0 → ∃ l, f l = n) (qf_zero : ∀ (l : L), q (f l) = 0) (pL : M →+ L →+ TL) (pN : M →+ N →+ TN)
  (pQ : M →+ Q →+ TQ) (tensorL : NotesProofs.IsBalancedTensor pL) (tensorN : NotesProofs.IsBalancedTensor pN)
  (tensorQ : NotesProofs.IsBalancedTensor pQ) (tf : TL →ₗ[S] TN) (tq : TN →ₗ[S] TQ)
  (tf_pure : ∀ (m : M) (l : L), tf ((pL m) l) = (pN m) (f l))
  (tq_pure : ∀ (m : M) (n : N), tq ((pN m) n) = (pQ m) (q n)) :
  (∀ (z : TL), tq (tf z) = 0) ∧
    ∀ (D : Type v) [inst : AddCommGroup D] [inst_1 : Module S D] (h : TN →ₗ[S] D),
      (∀ (z : TL), h (tf z) = 0) → ∃! k, ∀ (z : TN), k (tq z) = h z
