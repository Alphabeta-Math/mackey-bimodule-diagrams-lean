  (f g : ChoiceFreeWatts.Tensor right X →+ Y)
  (h : ∀ (m : M) (x : X), f (ChoiceFreeWatts.pure right m x) = g (ChoiceFreeWatts.pure right m x)) : f = g
ModuleTensorUniversalProperty.{u, v, w, z} (R : Type u) (M : Type v) (N : Type w) [Ring R] [AddCommGroup M]
  [AddCommGroup N] [Module Rᵐᵒᵖ M] [Module R N] :
  let F := M × N →₀ ℤ;
  have gen := fun p => Finsupp.single p 1;
  have H :=
    AddSubgroup.closure
      {x |
        (∃ m m' n, x = gen (m + m', n) - gen (m, n) - gen (m', n)) ∨
          (∃ m n n', x = gen (m, n + n') - gen (m, n) - gen (m, n')) ∨
            ∃ r m n, x = gen (MulOpposite.op r • m, n) - gen (m, r • n)};
  let T := F ⧸ H;
  have τ := fun p => (QuotientAddGroup.mk' H) (gen p);
  ((∀ (m m' : M) (n : N), τ (m + m', n) = τ (m, n) + τ (m', n)) ∧
      (∀ (m : M) (n n' : N), τ (m, n + n') = τ (m, n) + τ (m, n')) ∧
        ∀ (r : R) (m : M) (n : N), τ (MulOpposite.op r • m, n) = τ (m, r • n)) ∧
    ∀ (A : Type z) [inst : AddCommGroup A],
      let Bal :=
        { b //
          (∀ (m m' : M) (n : N), b (m + m', n) = b (m, n) + b (m', n)) ∧
            (∀ (m : M) (n n' : N), b (m, n + n') = b (m, n) + b (m, n')) ∧
              ∀ (r : R) (m : M) (n : N), b (MulOpposite.op r • m, n) = b (m, r • n) };
      (∀ (b : Bal), ∃! lift, ∀ (m : M) (n : N), lift (τ (m, n)) = ↑b (m, n)) ∧
        ∃ e, ∀ (f : T →+ A) (p : M × N), ↑(e f) p = f (τ p)
