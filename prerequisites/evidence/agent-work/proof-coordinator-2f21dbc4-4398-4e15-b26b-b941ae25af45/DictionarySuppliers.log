BimoduleFunctorHomEquivalence : ∀ (R S : Type v) [inst : Ring R] [inst_1 : Ring S],
  have tensor := NotesProofs.General.ConcreteBimodule.tensorRepresentation R S;
  have regular := ChoiceFreeWatts.regular R;
  tensor.Full ∧
    tensor.Faithful ∧
      tensor.EssSurj ∧
        ∃ E,
          E.functor = tensor ∧
            (∀ (F : NotesProofs.General.ConcreteBimodule.GoodFunctors R S),
                E.inverse.obj F = NotesProofs.General.ConcreteBimodule.wattsBimodule R S F.obj) ∧
              (∀ {F G : NotesProofs.General.ConcreteBimodule.GoodFunctors R S} (η : F ⟶ G),
                  ↑(E.inverse.map η) ≍ ModuleCat.Hom.hom (η.hom.app regular)) ∧
                (∀ (F : NotesProofs.General.ConcreteBimodule.GoodFunctors R S) (X : ModuleCat R),
                    ModuleCat.Hom.hom ((E.counitIso.hom.app F).hom.app X) ≍ ChoiceFreeWatts.comparison F.obj X) ∧
                  ∀ (B : NotesProofs.General.ConcreteBimodule R S),
                    ↑(E.unitIso.inv.app B) ≍ NotesProofs.General.concreteTensorUnitor B.carrier
ReconstructionFromSmallProjectiveGenerator : ∀ (C : Type u_1) [inst : Category.{u_2, u_1} C]
  [LocallySmall.{u_2, u_2, u_1} C] [inst_2 : Abelian C] [inst_3 : HasCoproducts C] (P : C) [Projective P],
  IsSeparator P →
    (∀ (I : Type u_2) (X : I → C),
        Function.Bijective ⇑(DirectSum.toAddMonoid fun i => Preadditive.rightComp P (Sigma.ι X i))) →
      let R := (End P)ᵐᵒᵖ;
      have H := preadditiveCoyonedaObj P;
      ∃ L, Nonempty (L ⋙ H ≅ 𝟭 (ModuleCat R)) ∧ Nonempty (H ⋙ L ≅ 𝟭 C)
@AbelianEquivalencesPreserveFunctorHypotheses : ∀ {C : Type u_1} {D : Type u_2} [inst : Category.{u_3, u_1} C]
  [inst_1 : Category.{u_4, u_2} D] [inst_2 : Abelian C] [inst_3 : Abelian D] (e : C ≌ D),
  have F := e.functor;
  F.Additive ∧
    (∀ {X Y : C} (f : X ⟶ Y), PreservesLimit (parallelPair f 0) F ∧ PreservesColimit (parallelPair f 0) F) ∧
      (∀ (I : Type u_5), PreservesColimitsOfShape (Discrete I) F) ∧
        (∀ [inst_4 : F.Additive] (S : ShortComplex C), S.Exact → (S.map F).Exact) ∧
          ∀ [inst_4 : HasCoproducts C],
            ∃ (hD : HasCoproducts D),
              ∀ (P : C),
                Projective P →
                  IsSeparator P →
                    (∀ (I : Type u_5) (X : I → C),
                        Function.Bijective ⇑(DirectSum.toAddMonoid fun i => Preadditive.rightComp P (Sigma.ι X i))) →
                      Projective (F.obj P) ∧
                        IsSeparator (F.obj P) ∧
                          ∀ (I : Type u_5) (Y : I → D),
                            Function.Bijective
                              ⇑(DirectSum.toAddMonoid fun i => Preadditive.rightComp (F.obj P) (Sigma.ι Y i))
